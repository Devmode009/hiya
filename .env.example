# Local development. Copy to .env and choose your own password (12+ characters).
MONGODB_URI=mongodb://127.0.0.1:27017/haya?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=haya
APP_ORIGIN=http://localhost:5173
PORT=4000
LOCAL_ADMIN_PASSWORD=
BOOTSTRAP_OWNER_EMAIL=owner@haya.local
# true seeds the example project and four demo-role accounts; never use in production.
SEED_DEMO=true

# AWS production values are provided to ECS by the deployment template.
# NODE_ENV=production
# AWS_REGION=ap-south-1
# S3_BUCKET=
# COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# Optional standalone frontend demo builds only. Leave unset for AWS production.
# VITE_DEMO_MODE=true
