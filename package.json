{
  "name": "haya-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:mongo": "node scripts/dev-mongo.mjs",
    "dev:server": "node scripts/dev.mjs --api-only",
    "dev:full": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "aws-jwt-verify": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
